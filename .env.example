# CRM Docker 环境变量模板
# 复制此文件为 .env 并修改实际值
# cp .env.example .env

# ==================== 数据库 ====================
MYSQL_ROOT_PASSWORD=root123456
DB_PASSWORD=crm123456

# ==================== Redis ====================
REDIS_PASSWORD=

# ==================== JWT ====================
# 生产环境必须修改！生成命令: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-openssl-rand-hex-32

# ==================== 双因素认证（082）====================
# TOTP 密钥的静态加密密钥（AES-256-GCM）。缺失时 2FA 绑定/启用会在调用时报 MFA_SECRET_MISSING。
# 生产环境必须修改！生成命令: openssl rand -base64 32
MFA_SECRET_KEY=

# ==================== 后端 ====================
SPRING_PROFILES_ACTIVE=prod

# ==================== 邮件（SMTP）====================
# 030 邮件营销。全部留空 = 邮件通道未启用：营销群发/定时导出通知的记录会标记 SKIPPED，
# 界面提示"邮件未真实发送"（不会再显示成已发送）。需要真实发信时填写以下各项。
CRM_MAIL_HOST=
CRM_MAIL_PORT=587
CRM_MAIL_USERNAME=
CRM_MAIL_PASSWORD=
CRM_MAIL_FROM=crm@example.com
# 101 收信侧诚实化：本项没有接入真实 IMAP。留空/false = 同步端点回 409 且不写任何记录；
# 置 true 才允许生成一条状态为 SIMULATED 的演示记录（界面标"模拟"，不显示成"已同步"）。
# ⚠️ 置 true 只表示"允许生成演示记录"，不是连通性探测。
CRM_MAIL_INBOUND_DEMO_ENABLED=

# ==================== 定时作业（1.3）====================
# SLA 升级扫描间隔（cron 表达式），默认每 10 分钟。
# 响应/解决时限的到位判定与升级分级见 SlaEscalationService。
CRM_SCHEDULER_SLA_CRON=0 */10 * * * ?

# ==================== 出站地址白名单（SSRF 防护）====================
# 逗号分隔的主机名或字面地址。⚠️ **留空 = 拒绝一切出站目标，公网地址同样拒绝**：
# Webhook 回调与集成渠道在默认配置下全部不可用（拒绝理由会区分"目标是内网地址"与
# "不在白名单内"）。要回调外部服务的部署必须在此显式列出目标主机，例如：
#   CRM_OUTBOUND_ALLOWED_HOSTS=hooks.example.com,10.0.0.8
# 判定细则（白名单优先于网段判定；不覆盖 DNS 重绑定）见 com.crm.common.OutboundUrlValidator。
CRM_OUTBOUND_ALLOWED_HOSTS=

# ==================== AI 文本生成（104）====================
# ⚠️ **默认关闭**：这几行留空/为 false 时，出厂状态零出站、零成本、零行为变化（生成端点回 409 且不发起任何请求）。
# 要启用：① 置 CRM_AI_ENABLED=true；② 填 CRM_AI_BASE_URL 与 CRM_AI_API_KEY；
# ③ **把模型主机加进上面的 CRM_OUTBOUND_ALLOWED_HOSTS**——否则应用**启动即失败**。
# 第 ③ 步不是可选的：SDK 内部走 OkHttp，绕过 OutboundUrlValidator 的逐跳校验，
# 启动期的这一次校验是本项唯一的出站准入控制。
#
# CRM_AI_BASE_URL 可指向自建网关／代理，但协议须是 Anthropic Messages API
# （跑本地模型需要前置协议转换网关）。
# ⚠️ 密钥不进日志、不进响应、不进审计 detail；本文件只放**空占位**，真实值走部署侧的密钥注入。
CRM_AI_ENABLED=false
CRM_AI_BASE_URL=
CRM_AI_API_KEY=
# 模型与上限。默认模型是能力默认值，**不是**成本最优选择——按用量与预算自行改。
CRM_AI_MODEL=claude-opus-5
CRM_AI_MAX_TOKENS=4096
CRM_AI_TIMEOUT_SECONDS=60
