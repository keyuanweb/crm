<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.2.0</version>
    <relativePath/>
  </parent>

  <groupId>com.crm</groupId>
  <artifactId>crm-backend</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>crm-backend</name>
  <description>Spring-Boot-React-CRM backend</description>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!--
      jacoco prepare-agent 会向该属性追加代理参数；surefire 与 failsafe 都默认取用 ${argLine}，
      故两者的覆盖率都会写入同一个 jacoco.exec。这是集成测试覆盖率能计入报告的唯一通路。

      ⚠️ 不要在 surefire / failsafe 的 <configuration> 里另写 <argLine> 而漏掉 @{argLine} 占位——
      两者分属不同 JVM，漏掉后集成测试的覆盖率不会写入 jacoco.exec，而构建仍然成功，
      覆盖率门禁会以"数字偏低但过得去"的形式静默失效。需要追加 JVM 参数时，
      应继续在此处追加，而不是覆盖插件级配置。
    -->
    <argLine>-Dfile.encoding=UTF-8</argLine>
    <mybatis-plus.version>3.5.5</mybatis-plus.version>
    <springdoc.version>2.3.0</springdoc.version>
    <poi.version>5.2.5</poi.version>
    <openpdf.version>1.3.30</openpdf.version>
    <jjwt.version>0.12.5</jjwt.version>
    <!--
      082：二维码生成。**必须显式写版本**——Spring Boot 3.2.0 的 BOM 不管理 com.google.zxing，
      不写版本会直接报 'dependencies.dependency.version' is missing。本机 m2 已有 3.5.3（jar 与 pom 齐），
      故离线可构建；这与立项计划里"m2 里没有、首次构建需要网络"的假设相反，已按实测订正。
    -->
    <zxing.version>3.5.3</zxing.version>
    <spotless.version>2.43.0</spotless.version>
    <jacoco.version>0.8.11</jacoco.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-aop</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-mail</artifactId>
    </dependency>
    <!-- 083：进程内缓存。必须进程内而非 Redis——集成测试将 RedisTemplate 声明为测试替身，
         用外部缓存会使缓存行为在测试中静默失效（research.md §4）。
         本 starter 提供 CaffeineCache 所需的 spring-context-support。 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.ben-manes.caffeine</groupId>
      <artifactId>caffeine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.baomidou</groupId>
      <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
      <version>${mybatis-plus.version}</version>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.flywaydb</groupId>
      <artifactId>flyway-mysql</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.librepdf</groupId>
      <artifactId>openpdf</artifactId>
      <version>${openpdf.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-api</artifactId>
      <version>${jjwt.version}</version>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-impl</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.jsonwebtoken</groupId>
      <artifactId>jjwt-jackson</artifactId>
      <version>${jjwt.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <!-- 082：TOTP 密钥的 Base32 编解码（RFC 4648）直接依赖 commons-codec 的 Base32，
           而不是自己写一份 Base32。显式声明在这里、**不写版本**（由 Spring Boot BOM 管）：
           此前它只是经 poi 传递到编译路径上的，POI 一升级或一移除，鉴权路径上就会静默少一个类型。 -->
      <groupId>commons-codec</groupId>
      <artifactId>commons-codec</artifactId>
    </dependency>
    <dependency>
      <!-- 082：TOTP 绑定二维码。**只引 core，不引 javase**——javase 提供的 MatrixToImageWriter
           只省下 MfaQrCodeService 里那十行把 BitMatrix 涂进 BufferedImage 的代码，
           代价是让一条鉴权路径多背一个绘图依赖；而 PNG 编码本身用 JDK 自带的 ImageIO 就够。
           版本必须显式写（BOM 不管 zxing），见上面 <properties> 里的说明。 -->
      <groupId>com.google.zxing</groupId>
      <artifactId>core</artifactId>
      <version>${zxing.version}</version>
    </dependency>

    <!-- Test -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless.version}</version>
        <configuration>
          <java>
            <googleJavaFormat>
              <version>1.19.2</version>
              <style>GOOGLE</style>
            </googleJavaFormat>
            <removeUnusedImports/>
          </java>
        </configuration>
        <executions>
          <execution>
            <id>spotless-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!--
        maven-failsafe-plugin：实际执行集成测试（*IT.java）。
        在此之前 61 个 *IT 类被编写、被编译，但从不执行——surefire 的默认包含是 **/*Test.java，
        不含 **/*IT.java，而构建里根本没有 failsafe。本插件是 FR-G01 的唯一落点。
        （计数说明：上述 61 是接入 failsafe 前的存量；接入后新增 5 个 IT 类，现共 66 个，
        每次运行同样份数的 *IT 报告——见 specs/083-engineering-consolidation/baseline.md §6。）
        <includes> 虽与 failsafe 默认值一致，仍显式声明：范围是需求的一部分，不应依赖插件默认值。
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*IT.java</include>
          </includes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <configuration>
          <excludes>
            <exclude>com/crm/CrmApplication.class</exclude>
            <exclude>com/crm/dto/**</exclude>
            <exclude>com/crm/entity/**</exclude>
            <exclude>com/crm/common/**</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <!--
            report 必须晚于 integration-test，否则报告只含 surefire 口径的覆盖率。
            原绑 test 相位时，报告在 failsafe 之前生成——即使报告存在，数字也系统性偏低，
            是"看起来有覆盖率"的假绿来源之一。
          -->
          <execution>
            <id>report</id>
            <phase>post-integration-test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>coverage-check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>INSTRUCTION</counter>
                      <value>COVEREDRATIO</value>
                      <!--
                        实测（2026-09-12，接入 failsafe 且报告改在 post-integration-test 生成）：
                        INSTRUCTION covered 41 544 / total 55 274 = 0.7516；同日复测（用例集增大后）
                        covered 44 008 / total 56 288 = **0.7818**——该次复测同时是本 check 在本规格内
                        **首次被实际执行**：带 -Dmaven.test.failure.ignore=true 跑到 verify 末，
                        日志出现 `jacoco:0.8.11:check (coverage-check)`，判定通过。
                        改造前仅 surefire 口径为 0.5093（见 specs/083-engineering-consolidation/baseline.md），
                        差值约 24 个百分点即集成测试的贡献——这正是本门禁此前无法度量的部分。

                        ✅ 2026-09-12 复核（T066）：原先此处写着"当前有 3 例单元失败，故字面执行
                        mvn -B verify 看不到任何集成测试结果与覆盖率结果"。那 3 例已修复，且属**测试契约
                        缺陷**而非产品问题——分别是 mock 未复现 MyBatis-Plus 的 insert 主键回填、anyString()
                        不匹配 null 使桩静默未命中、以及一条从未被执行过的 times(2) 断言。现 surefire 实测
                        537 例 / 0 失败 / 0 错误（同日复测。数字属时点采样、非契约——它随任何会话新增
                        用例而变，488 是同日较早一次的采样值），生命周期不再中止在 test 相位：failsafe
                        会真正执行完 255 例，jacoco:report（绑 post-integration-test）也会生成。

                        ⚠️ 但仍**必须**加 -Dmaven.test.failure.ignore=true 才能看到本 check 的判定结果：
                        卡点只是从 test 相位移到了 verify 相位。failsafe:verify 当前有 4 例业务类失败
                        （2026-09-12 全量实测 255 run / 4F / 0E：IntegrationHubIT 时序 1、OpportunityIT
                        校验优先级 1、UserIT 2），它失败即中止构建；而本 check 与之同一相位、且声明在其后，
                        按 Maven 失败即中止的语义不会被执行。**同相位内 spotless:check 声明在本插件之前，故格式违规比用例失败更早中止构建**（2026-09-12 实测：三处未按 google-java-format
                        排版的改动使该相位在 spotless 处即失败，此时 failsafe 的用例判定与覆盖率判定都看不到）。
                        改造前该值为 6 例——其中 2 例
                        （SystemEnhancementIT）已随 export_job.export_format 缺列的修复转绿，见该规格
                        spec.md「复核与更正」节。

                        门禁取 0.73：定基时距实测 0.7516 约 2.2 个百分点，够吸收浮点与测试增删的抖动，
                        同时不给"静默退化"留空间（旧值 0.30 距实测 45 个百分点，等于不设防）。
                        注意该差值会随时间单向上移——分子随用例增加而增长，分母基本不变，故**固定阈值
                        必然逐渐变松**（同日复测已从 2.2 点变宽到约 5 点）。一旦宽到让退化不被发现，
                        必须重新定基并在 specs 中记录新的实测值与理由，而不是继续沿用旧阈值。
                      -->
                      <minimum>0.73</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
